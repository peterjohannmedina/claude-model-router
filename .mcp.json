{
  "mcpServers": {
    "local-inference": {
      "type": "stdio",
      "command": "node",
      "args": ["${CLAUDE_PROJECT_DIR:-.}/mcp/local-inference-mcp.js"],
      "env": {
        "LOCAL_WORKER_MAX_OUTPUT_TOKENS": "4000",
        "LOCAL_WORKER_TIMEOUT_MS": "60000",
        "LOCAL_WORKER_TEMPERATURE": "0"
      },
      "timeout": 60000
    }
  }
}
