{
  "permissions": {
    "allow": [
      "mcp__local-inference__local_extract",
      "mcp__local-inference__local_classify",
      "mcp__local-inference__local_review_diff"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/verify-local-inference-claude-resource.js\" --hook=SessionStart",
            "timeout": 8,
            "statusMessage": "Checking local muse resource..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(Agent|Task)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/verify-local-inference-claude-resource.js\" --hook=PreToolUse",
            "timeout": 8,
            "statusMessage": "Verifying local worker availability..."
          }
        ]
      },
      {
        "matcher": "^mcp__local[-_]inference__.*$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/verify-local-inference-claude-resource.js\" --hook=PreToolUse",
            "timeout": 8,
            "statusMessage": "Verifying local muse resource..."
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "^local[-_]muse[-_]worker$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/verify-local-inference-claude-resource.js\" --hook=SubagentStart",
            "timeout": 8,
            "statusMessage": "Confirming local muse worker..."
          }
        ]
      }
    ]
  }
}
