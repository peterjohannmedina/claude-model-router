    "test:resource": "node --test tests/local-resource-verification.test.js",
    "test:claude-resource": "node --test tests/local-claude-resource-verification.test.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "ajv": "^8.18.0",
    "zod": "^4.3.6"
  }
}
