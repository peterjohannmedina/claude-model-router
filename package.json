  "description": "MCP worker that lets Claude Code and Codex delegate bounded semantic tasks to a trusted LAN model served by LiteLLM.",
  "license": "ISC",
  "type": "commonjs",
  "main": "mcp/local-inference-mcp.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "mcp:local-inference": "node mcp/local-inference-mcp.js",
